<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.guanghe.fs</groupId>
        <artifactId>fs-storage-plugin</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>storage-plugin-boot</artifactId>

    <description>
        storage-plugin-boot - 存储插件-管理模块
    </description>

    <dependencies>
        <!-- 本地存储插件（默认包含） -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-local</artifactId>
        </dependency>

        <!-- OSS 插件（S3 兼容：阿里云 OSS / MinIO / RustFS / AWS S3） -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-rustfs</artifactId>
        </dependency>

        <!-- SMB 插件 -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-smb</artifactId>
        </dependency>

        <!-- WebDAV 插件 -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-webdav</artifactId>
        </dependency>

        <!-- SFTP 插件 -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-sftp</artifactId>
        </dependency>

        <!-- FTP/FTPS 插件 -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-ftp</artifactId>
        </dependency>

        <!-- 本地挂载插件 -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-localmount</artifactId>
        </dependency>

        <!-- 内存存储插件 -->
        <dependency>
            <groupId>com.guanghe.fs</groupId>
            <artifactId>storage-plugin-memory</artifactId>
        </dependency>

    </dependencies>
</project>
